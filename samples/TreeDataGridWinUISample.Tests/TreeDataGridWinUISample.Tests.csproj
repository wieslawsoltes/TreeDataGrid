<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Uno sample tests linked unchanged and built for Windows, where the linked sample
       services compile their WINDOWS paths. They need no XAML runtime, so dotnet test runs them. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);TREEDATAGRID_UNO_SAMPLE;TREEDATAGRID_WINUI</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../TreeDataGridUnoSample.Tests/**/*.cs"
             Exclude="../TreeDataGridUnoSample.Tests/bin/**;../TreeDataGridUnoSample.Tests/obj/**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../TreeDataGridUnoShared/SampleRunContext.cs" Link="Infrastructure/SampleRunContext.cs" />
    <Compile Include="../TreeDataGridUnoShared/ObservableSampleModel.cs" Link="Infrastructure/ObservableSampleModel.cs" />
    <Compile Include="../TreeDataGridUnoSample/WikipediaViewModel.cs" Link="WikipediaViewModel.cs" />
    <Compile Include="../TreeDataGridUnoActivityMonitor/Models/MonitorModels.cs" Link="ActivityMonitor/MonitorModels.cs" />
    <Compile Include="../TreeDataGridUnoActivityMonitor/Services/*.cs" Link="ActivityMonitor/%(Filename)%(Extension)" />
    <Compile Include="../TreeDataGridUnoSample/FilesViewModel.cs" Link="FilesViewModel.cs" />
    <Compile Include="../TreeDataGridUnoSample/FindCountryViewModel.cs" Link="FindCountryViewModel.cs" />
    <Compile Include="../TreeDataGridDemo/Models/Country.cs" Link="Models/Country.cs" />
    <Compile Include="../TreeDataGridDemo/Models/Countries.cs" Link="Models/Countries.cs" />
    <Compile Include="../TreeDataGridDemo/Models/FileTreeNodeModel.cs" Link="Models/FileTreeNodeModel.cs" />
    <Compile Include="../TreeDataGridDemo/Models/OnThisDay.cs" Link="Models/OnThisDay.cs" />
    <Compile Include="../TreeDataGridDemo/Models/OnThisDayJsonSerializerContext.cs" Link="Models/OnThisDayJsonSerializerContext.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../../src/TreeDataGrid.Core/TreeDataGrid.Core.csproj" />
  </ItemGroup>
</Project>
