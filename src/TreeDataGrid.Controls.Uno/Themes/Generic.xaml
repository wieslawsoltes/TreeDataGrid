<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Keep the public Avalonia brush names so applications can apply the same
       semantic overrides. ThemeResource, rather than fixed colors in controls,
       also updates retained/recycled visuals when RequestedTheme changes. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="TreeDataGridGridLinesBrush" Color="White" Opacity="0.1" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPointerOverBrush" Color="White" Opacity="0.1" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPressedBrush" Color="White" Opacity="0.4" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPointerOverBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPressedBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPointerOverBrush" Color="White" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPressedBrush" Color="White" />
      <SolidColorBrush x:Key="TreeDataGridSelectedCellBackgroundBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="TreeDataGridSelectedCellForegroundBrush" Color="White" />
      <SolidColorBrush x:Key="TreeDataGridCurrentCellBorderBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="TreeDataGridValidationBorderBrush" Color="#FFFF99A4" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="TreeDataGridGridLinesBrush" Color="Black" Opacity="0.1" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPointerOverBrush" Color="Black" Opacity="0.1" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPressedBrush" Color="Black" Opacity="0.4" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPointerOverBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPressedBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPointerOverBrush" Color="Black" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPressedBrush" Color="Black" />
      <SolidColorBrush x:Key="TreeDataGridSelectedCellBackgroundBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="TreeDataGridSelectedCellForegroundBrush" Color="Black" />
      <SolidColorBrush x:Key="TreeDataGridCurrentCellBorderBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="TreeDataGridValidationBorderBrush" Color="#FFC42B1C" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="TreeDataGridGridLinesBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPointerOverBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPressedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="TreeDataGridSelectedCellBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="TreeDataGridSelectedCellForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="TreeDataGridCurrentCellBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TreeDataGridValidationBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Style TargetType="TreeDataGridColumnResizer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGridColumnResizer">
          <Thumb x:Name="PART_Thumb" Background="{TemplateBinding Background}" IsTabStop="False">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="TreeDataGridHeaderStringTemplate">
    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
  </DataTemplate>
  <TreeDataGridHeaderTemplateSelector x:Key="TreeDataGridDefaultHeaderTemplateSelector"
                                               StringTemplate="{StaticResource TreeDataGridHeaderStringTemplate}" />
  <Style TargetType="TreeDataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ContentTemplateSelector" Value="{StaticResource TreeDataGridDefaultHeaderTemplateSelector}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGridColumnHeader">
          <Grid x:Name="HeaderRoot" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HeaderBorder.Background" Value="{ThemeResource TreeDataGridHeaderBackgroundPointerOverBrush}" />
                    <Setter Target="HeaderBorder.BorderBrush" Value="{ThemeResource TreeDataGridHeaderBorderBrushPointerOverBrush}" />
                    <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TreeDataGridHeaderForegroundPointerOverBrush}" />
                    <Setter Target="SortIconAscending.Fill" Value="{ThemeResource TreeDataGridHeaderForegroundPointerOverBrush}" />
                    <Setter Target="SortIconDescending.Fill" Value="{ThemeResource TreeDataGridHeaderForegroundPointerOverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HeaderBorder.Background" Value="{ThemeResource TreeDataGridHeaderBackgroundPressedBrush}" />
                    <Setter Target="HeaderBorder.BorderBrush" Value="{ThemeResource TreeDataGridHeaderBorderBrushPressedBrush}" />
                    <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TreeDataGridHeaderForegroundPressedBrush}" />
                    <Setter Target="SortIconAscending.Fill" Value="{ThemeResource TreeDataGridHeaderForegroundPressedBrush}" />
                    <Setter Target="SortIconDescending.Fill" Value="{ThemeResource TreeDataGridHeaderForegroundPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters><Setter Target="HeaderRoot.Opacity" Value="0.4" /></VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SortingStates">
                <VisualState x:Name="Unsorted" />
                <VisualState x:Name="SortAscending">
                  <VisualState.Setters>
                    <Setter Target="SortIconAscending.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SortDescending">
                  <VisualState.Setters>
                    <Setter Target="SortIconDescending.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="5" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <!-- Each template instance owns its geometry: WinUI does not share a Geometry between
                     elements. Explicit figures keep the original glyph vertices on every head. -->
                <Path x:Name="SortIconAscending" Grid.Column="1" Width="12" Height="12" Stretch="Uniform"
                      Margin="2,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Visibility="Collapsed">
                  <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="1965,947" IsClosed="True">
                          <LineSegment Point="1024,6" /><LineSegment Point="83,947" />
                          <LineSegment Point="173,1037" /><LineSegment Point="960,250" />
                          <LineSegment Point="960,2048" /><LineSegment Point="1088,2048" />
                          <LineSegment Point="1088,250" /><LineSegment Point="1875,1037" />
                        </PathFigure>
                    </PathGeometry>
                  </Path.Data>
                </Path>
                <Path x:Name="SortIconDescending" Grid.Column="1" Width="12" Height="12" Stretch="Uniform"
                      Margin="2,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Visibility="Collapsed">
                  <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="1875,1011" IsClosed="True">
                          <LineSegment Point="1088,1798" /><LineSegment Point="1088,0" />
                          <LineSegment Point="960,0" /><LineSegment Point="960,1798" />
                          <LineSegment Point="173,1011" /><LineSegment Point="83,1101" />
                          <LineSegment Point="1024,2042" /><LineSegment Point="1965,1101" />
                        </PathFigure>
                    </PathGeometry>
                  </Path.Data>
                </Path>
                <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Right"
                           Fill="{ThemeResource TreeDataGridGridLinesBrush}" />
                <TreeDataGridColumnResizer x:Name="PART_Resizer" Grid.Column="2" Width="5" Background="Transparent" IsTabStop="False" />
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TreeDataGridExpandCollapseChevron" TargetType="TreeDataGridExpanderButton">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGridExpanderButton">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ExpansionStates">
                <VisualState x:Name="Collapsed" />
                <VisualState x:Name="Expanded">
                  <VisualState.Setters>
                    <Setter Target="CollapsedChevron.Visibility" Value="Collapsed" />
                    <Setter Target="ExpandedChevron.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters><Setter Target="Chevron.Opacity" Value="0.7" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters><Setter Target="Chevron.Opacity" Value="0.5" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters><Setter Target="Chevron.Opacity" Value="0.4" /></VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="Chevron" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="CollapsedChevron" Fill="{TemplateBinding Foreground}" Stretch="Uniform">
                <Path.Data>
                  <PathGeometry>
                    <PathFigure StartPoint="1,0" IsClosed="True">
                      <LineSegment Point="10,10" /><LineSegment Point="1,20" />
                      <LineSegment Point="0,19" /><LineSegment Point="8,10" /><LineSegment Point="0,1" />
                    </PathFigure>
                  </PathGeometry>
                </Path.Data>
              </Path>
              <Path x:Name="ExpandedChevron" Fill="{TemplateBinding Foreground}" Stretch="Uniform" Visibility="Collapsed">
                <Path.Data>
                  <PathGeometry>
                    <PathFigure StartPoint="0,1" IsClosed="True">
                      <LineSegment Point="10,10" /><LineSegment Point="20,1" />
                      <LineSegment Point="19,0" /><LineSegment Point="10,8" /><LineSegment Point="1,0" />
                    </PathFigure>
                  </PathGeometry>
                </Path.Data>
              </Path>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeDataGridRow">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGridRow">
          <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <!-- Visual state groups must be declared on the template root. -->
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="RowSelectionBackground.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          <Grid>
            <Border x:Name="RowSelectionBackground" Background="{ThemeResource TreeDataGridSelectedCellBackgroundBrush}" Opacity="0" />
            <TreeDataGridCellsPresenter x:Name="PART_CellsPresenter"
                        ElementFactory="{TemplateBinding ElementFactory}" Items="{TemplateBinding Columns}" Rows="{TemplateBinding Rows}" />
          </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeDataGrid">
    <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGrid">
          <Border x:Name="RootBorder" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ScrollViewer x:Name="PART_HeaderScrollViewer" IsTabStop="False" HorizontalAlignment="Left"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <Border x:Name="ColumnHeadersPresenterBorder" BorderBrush="{ThemeResource TreeDataGridGridLinesBrush}" BorderThickness="0,0,0,1">
                  <TreeDataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                              ElementFactory="{TemplateBinding ElementFactory}" Items="{TemplateBinding Columns}" />
                </Border>
              </ScrollViewer>
              <ScrollViewer x:Name="PART_ScrollViewer" Grid.Row="1" IsTabStop="False"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TreeDataGridRowsPresenter x:Name="PART_RowsPresenter"
                            ElementFactory="{TemplateBinding ElementFactory}" Columns="{TemplateBinding Columns}" Items="{TemplateBinding Rows}" />
              </ScrollViewer>
              <Canvas x:Name="PART_DragOverlay" Grid.Row="1" IsHitTestVisible="False">
                <Border x:Name="PART_DropIndicator" BorderBrush="{ThemeResource TreeDataGridCurrentCellBorderBrush}"
                        BorderThickness="2" Visibility="Collapsed" />
              </Canvas>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TreeDataGridCellStyle" TargetType="TreeDataGridCell">
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGridCell">
          <Border x:Name="CellBorder" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="SelectionBackground.Opacity" Value="1" />
                    <Setter Target="PART_Text.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    <Setter Target="PART_Expander.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    <Setter Target="PART_Content.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    <Setter Target="PART_CheckBox.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RowSelected">
                  <VisualState.Setters>
                    <Setter Target="PART_Text.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    <Setter Target="PART_Expander.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    <Setter Target="PART_Content.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    <Setter Target="PART_CheckBox.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CurrentStates">
                <VisualState x:Name="NotCurrent" />
                <VisualState x:Name="Current">
                  <VisualState.Setters>
                    <Setter Target="CurrentBorder.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="ValidationStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                  <VisualState.Setters>
                    <Setter Target="ValidationBorder.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          <Grid>
            <Border x:Name="SelectionBackground" Background="{ThemeResource TreeDataGridSelectedCellBackgroundBrush}" Opacity="0" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TreeDataGridExpanderButton x:Name="PART_Expander" Style="{StaticResource TreeDataGridExpandCollapseChevron}"
                      Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <TreeDataGridCellContentPanel Grid.Column="1">
                <TextBlock x:Name="PART_Text" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{TemplateBinding Foreground}" />
                <CheckBox x:Name="PART_CheckBox" Margin="{TemplateBinding Padding}" MinWidth="0" IsTabStop="False" VerticalAlignment="Center"
                          Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter x:Name="PART_Content" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" />
                <Grid x:Name="PART_EditorHost" Visibility="Collapsed" />
                <ContentPresenter x:Name="PART_EditingContent" Visibility="Collapsed" />
              </TreeDataGridCellContentPanel>
            </Grid>
            <Border x:Name="CurrentBorder" BorderBrush="{ThemeResource TreeDataGridCurrentCellBorderBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ValidationBorder" BorderBrush="{ThemeResource TreeDataGridValidationBorderBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
          </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeDataGridCell" BasedOn="{StaticResource TreeDataGridCellStyle}" />
  <!-- Text columns do not need a checkbox, expander, nested column grids or a
       display ContentPresenter. Keep native editing and independent overlay
       states without constructing unused control/template trees per cell. -->
  <Style TargetType="TreeDataGridTextCell" BasedOn="{StaticResource TreeDataGridCellStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGridTextCell">
          <!-- The scalar text template uses only TemplateBindings. Isolate its
               private visual/state graph from row DataContext churn while the
               public row and cell retain their ordinary inherited contexts. -->
          <Border x:Name="CellBorder" DataContext="{x:Null}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SelectionStates">
                  <VisualState x:Name="Unselected" />
                  <VisualState x:Name="Selected">
                    <VisualState.Setters>
                      <Setter Target="SelectionBackground.Opacity" Value="1" />
                      <Setter Target="PART_Text.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="RowSelected">
                    <VisualState.Setters>
                      <Setter Target="PART_Text.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CurrentStates">
                  <VisualState x:Name="NotCurrent" />
                  <VisualState x:Name="Current">
                    <VisualState.Setters><Setter Target="CurrentBorder.Opacity" Value="1" /></VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ValidationStates">
                  <VisualState x:Name="Valid" />
                  <VisualState x:Name="Invalid">
                    <VisualState.Setters><Setter Target="ValidationBorder.Opacity" Value="1" /></VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            <TreeDataGridCellContentPanel>
              <Border x:Name="SelectionBackground" Background="{ThemeResource TreeDataGridSelectedCellBackgroundBrush}" Opacity="0" />
              <TextBlock x:Name="PART_Text" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                         TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}" />
              <Grid x:Name="PART_EditorHost" Visibility="Collapsed" />
              <ContentPresenter x:Name="PART_EditingContent" Visibility="Collapsed" />
              <Border x:Name="CurrentBorder" BorderBrush="{ThemeResource TreeDataGridCurrentCellBorderBrush}"
                      BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="ValidationBorder" BorderBrush="{ThemeResource TreeDataGridValidationBorderBrush}"
                      BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
            </TreeDataGridCellContentPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeDataGridCheckBoxCell" BasedOn="{StaticResource TreeDataGridCellStyle}" />
  <Style TargetType="TreeDataGridTemplateCell" BasedOn="{StaticResource TreeDataGridCellStyle}" />
  <Style TargetType="TreeDataGridExpanderCell" BasedOn="{StaticResource TreeDataGridCellStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeDataGridExpanderCell">
          <Border x:Name="CellBorder" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="SelectionBackground.Opacity" Value="1" />
                    <Setter Target="PART_Expander.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RowSelected">
                  <VisualState.Setters>
                    <Setter Target="PART_Expander.Foreground" Value="{ThemeResource TreeDataGridSelectedCellForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CurrentStates">
                <VisualState x:Name="NotCurrent" />
                <VisualState x:Name="Current">
                  <VisualState.Setters><Setter Target="CurrentBorder.Opacity" Value="1" /></VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="ValidationStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                  <VisualState.Setters><Setter Target="ValidationBorder.Opacity" Value="1" /></VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          <Grid>
            <Border x:Name="SelectionBackground" Background="{ThemeResource TreeDataGridSelectedCellBackgroundBrush}" Opacity="0" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TreeDataGridExpanderButton x:Name="PART_Expander" Style="{StaticResource TreeDataGridExpandCollapseChevron}"
                      Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <Border x:Name="PART_Content" Grid.Column="1" />
            </Grid>
            <Border x:Name="CurrentBorder" BorderBrush="{ThemeResource TreeDataGridCurrentCellBorderBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ValidationBorder" BorderBrush="{ThemeResource TreeDataGridValidationBorderBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
          </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
