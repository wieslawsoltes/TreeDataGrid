<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Uno.Controls"
                    xmlns:primitives="using:Uno.Controls.Primitives">
  <Style TargetType="local:TreeDataGrid">
    <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:TreeDataGrid">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ScrollViewer x:Name="PART_HeaderScrollViewer" IsTabStop="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <primitives:TreeDataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" />
              </ScrollViewer>
              <ScrollViewer x:Name="PART_ScrollViewer" Grid.Row="1" IsTabStop="False"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <primitives:TreeDataGridRowsPresenter x:Name="PART_RowsPresenter" />
              </ScrollViewer>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="primitives:TreeDataGridCell">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:TreeDataGridCell">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="SelectionBackground.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CurrentStates">
                <VisualState x:Name="NotCurrent" />
                <VisualState x:Name="Current">
                  <VisualState.Setters>
                    <Setter Target="CurrentBorder.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="ValidationStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                  <VisualState.Setters>
                    <Setter Target="ValidationBorder.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="SelectionBackground" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="PART_Expander" Width="20" Height="24" MinWidth="0" MinHeight="0"
                      Padding="0" IsTabStop="False" VerticalAlignment="Center" />
              <Grid Grid.Column="1">
                <TextBlock x:Name="PART_Text" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{TemplateBinding Foreground}" />
                <CheckBox x:Name="PART_CheckBox" Margin="8,0" MinWidth="0" IsTabStop="False" VerticalAlignment="Center" />
                <ContentPresenter x:Name="PART_Content" />
                <Grid x:Name="PART_EditorHost" Visibility="Collapsed" />
                <ContentPresenter x:Name="PART_EditingContent" Visibility="Collapsed" />
              </Grid>
            </Grid>
            <Border x:Name="CurrentBorder" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ValidationBorder" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
