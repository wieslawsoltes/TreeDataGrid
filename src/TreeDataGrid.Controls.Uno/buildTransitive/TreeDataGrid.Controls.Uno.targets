<Project>
  <!--
    TreeDataGrid types are registered for Uno's global XAML namespace ([XmlnsDefinition] in
    Properties/XamlNamespaces.cs), so XAML can use <TreeDataGrid>, <TreeDataGridTextColumn>,
    Style TargetType="TreeDataGridCell" and so on without declaring an xmlns prefix.

    Two places cannot resolve those names on their own; for them the project's XAML is rewritten
    into the intermediate directory with explicit using: prefixes (elements, property elements,
    attached properties, TargetType and Setter.Property values). Rewritten items keep their
    original path as Link metadata, so generated code, XBF output and ms-appx URIs are unchanged,
    and source files are never modified.

    - Windows App SDK heads: WinUI's markup compiler has no global namespace, so every XAML file
      using an unprefixed TreeDataGrid type is rewritten before MarkupCompilePass1.
    - Uno heads: the Uno generator resolves unprefixed elements but not TargetType and
      Setter.Property values, so only files with such values are rewritten (all other files keep
      XAML Hot Reload). With UnoEnableImplicitXamlNamespaces=false every such file is rewritten.

    Set TreeDataGridImplicitXamlNamespaces to false to opt out.
  -->
  <PropertyGroup>
    <TreeDataGridImplicitXamlNamespaces Condition="'$(TreeDataGridImplicitXamlNamespaces)' == ''">true</TreeDataGridImplicitXamlNamespaces>
    <!-- Public types of the namespaces registered for the global XAML namespace
         (kept in sync with the assembly by XamlNamespaceTests). -->
    <TreeDataGridXamlControlsTypes>CheckBoxColumnCreateOptions;ColumnCreateOptions;HierarchicalExpanderColumnCreateOptions;TemplateColumnCreateOptions;TextColumnCreateOptions;TreeDataGrid;TreeDataGridBindingRegistry;TreeDataGridCellEventArgs;TreeDataGridCheckBoxColumn;TreeDataGridColumn;TreeDataGridColumns;TreeDataGridDiagnostics;TreeDataGridHierarchicalExpanderColumn;TreeDataGridItemsSourceView;TreeDataGridNavigation;TreeDataGridRowDragEventArgs;TreeDataGridRowDragFailedEventArgs;TreeDataGridRowDragStartedEventArgs;TreeDataGridRowDropPosition;TreeDataGridRowEventArgs;TreeDataGridRowHeaderColumn;TreeDataGridRowModel;TreeDataGridRowModelEventArgs;TreeDataGridSelectionChangedEventArgs;TreeDataGridSelectionMode;TreeDataGridSourceExtensions;TreeDataGridTemplateColumn;TreeDataGridTextColumn</TreeDataGridXamlControlsTypes>
    <TreeDataGridXamlPrimitivesTypes>TreeDataGridCell;TreeDataGridCellContentPanel;TreeDataGridCellsPresenter;TreeDataGridCheckBoxCell;TreeDataGridColumnHeader;TreeDataGridColumnHeadersPresenter;TreeDataGridColumnResizer;TreeDataGridElementFactory;TreeDataGridExpanderButton;TreeDataGridExpanderCell;TreeDataGridHeaderTemplateSelector;TreeDataGridRow;TreeDataGridRowUnrealizeReason;TreeDataGridRowsPresenter;TreeDataGridTemplateCell;TreeDataGridTextCell</TreeDataGridXamlPrimitivesTypes>
  </PropertyGroup>

  <UsingTask TaskName="TreeDataGridRewriteImplicitXaml"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ControlsTypes ParameterType="System.String" Required="true" />
      <PrimitivesTypes ParameterType="System.String" Required="true" />
      <ProjectDirectory ParameterType="System.String" Required="true" />
      <OutputRoot ParameterType="System.String" Required="true" />
      <TypeValuesOnly ParameterType="System.Boolean" />
      <RewrittenFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)TreeDataGridImplicitXaml.cs" />
    </Task>
  </UsingTask>

  <!-- Resolved at execution time: IntermediateOutputPath is not defined yet where projects import this file. -->
  <Target Name="_TreeDataGridImplicitXamlOutputPath">
    <PropertyGroup>
      <TreeDataGridImplicitXamlOutputPath Condition="'$(TreeDataGridImplicitXamlOutputPath)' == ''">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'TreeDataGrid', 'ImplicitXaml'))/</TreeDataGridImplicitXamlOutputPath>
    </PropertyGroup>
  </Target>

  <Target Name="TreeDataGridRewriteImplicitXaml"
          DependsOnTargets="_TreeDataGridImplicitXamlOutputPath"
          BeforeTargets="MarkupCompilePass1;DesignTimeMarkupCompilationCT"
          Condition="'$(TreeDataGridImplicitXamlNamespaces)' == 'true' and '$(TargetPlatformIdentifier)' == 'windows' and '$(UseWinUI)' == 'true'">
    <TreeDataGridRewriteImplicitXaml InputFiles="@(Page)"
                                     ControlsTypes="$(TreeDataGridXamlControlsTypes)"
                                     PrimitivesTypes="$(TreeDataGridXamlPrimitivesTypes)"
                                     ProjectDirectory="$(MSBuildProjectDirectory)"
                                     OutputRoot="$(TreeDataGridImplicitXamlOutputPath)"
                                     Condition="'@(Page)' != ''">
      <Output TaskParameter="RewrittenFiles" ItemName="_TreeDataGridRewrittenPage" />
    </TreeDataGridRewriteImplicitXaml>
    <TreeDataGridRewriteImplicitXaml InputFiles="@(ApplicationDefinition)"
                                     ControlsTypes="$(TreeDataGridXamlControlsTypes)"
                                     PrimitivesTypes="$(TreeDataGridXamlPrimitivesTypes)"
                                     ProjectDirectory="$(MSBuildProjectDirectory)"
                                     OutputRoot="$(TreeDataGridImplicitXamlOutputPath)"
                                     Condition="'@(ApplicationDefinition)' != ''">
      <Output TaskParameter="RewrittenFiles" ItemName="_TreeDataGridRewrittenApplication" />
    </TreeDataGridRewriteImplicitXaml>
    <ItemGroup>
      <Page Remove="@(_TreeDataGridRewrittenPage->'%(TreeDataGridOriginalItemSpec)')" />
      <Page Include="@(_TreeDataGridRewrittenPage)" />
      <ApplicationDefinition Remove="@(_TreeDataGridRewrittenApplication->'%(TreeDataGridOriginalItemSpec)')" />
      <ApplicationDefinition Include="@(_TreeDataGridRewrittenApplication)" />
      <FileWrites Include="@(_TreeDataGridRewrittenPage);@(_TreeDataGridRewrittenApplication)" />
    </ItemGroup>
  </Target>

  <Target Name="TreeDataGridRewriteImplicitXamlForUno"
          DependsOnTargets="_TreeDataGridImplicitXamlOutputPath"
          AfterTargets="_InjectAdditionalFiles"
          Condition="'$(TreeDataGridImplicitXamlNamespaces)' == 'true' and !('$(TargetPlatformIdentifier)' == 'windows' and '$(UseWinUI)' == 'true')">
    <ItemGroup>
      <_TreeDataGridUnoXaml Include="@(AdditionalFiles)"
                            Condition="'%(AdditionalFiles.Extension)' == '.xaml' and ('%(AdditionalFiles.SourceItemGroup)' == 'Page' or '%(AdditionalFiles.SourceItemGroup)' == 'ApplicationDefinition')" />
    </ItemGroup>
    <TreeDataGridRewriteImplicitXaml InputFiles="@(_TreeDataGridUnoXaml)"
                                     ControlsTypes="$(TreeDataGridXamlControlsTypes)"
                                     PrimitivesTypes="$(TreeDataGridXamlPrimitivesTypes)"
                                     ProjectDirectory="$(MSBuildProjectDirectory)"
                                     OutputRoot="$(TreeDataGridImplicitXamlOutputPath)"
                                     TypeValuesOnly="$(UnoEnableImplicitXamlNamespaces)"
                                     Condition="'@(_TreeDataGridUnoXaml)' != ''">
      <Output TaskParameter="RewrittenFiles" ItemName="_TreeDataGridRewrittenUnoXaml" />
    </TreeDataGridRewriteImplicitXaml>
    <ItemGroup>
      <AdditionalFiles Remove="@(_TreeDataGridRewrittenUnoXaml->'%(TreeDataGridOriginalItemSpec)')" />
      <AdditionalFiles Include="@(_TreeDataGridRewrittenUnoXaml)" />
      <FileWrites Include="@(_TreeDataGridRewrittenUnoXaml)" />
      <_TreeDataGridUnoXaml Remove="@(_TreeDataGridUnoXaml)" />
    </ItemGroup>
  </Target>
</Project>
