<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreeDataGridSourceRoot Condition="'$(TreeDataGridSourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</TreeDataGridSourceRoot>
    <TreeDataGridUnoTargetFrameworks>net10.0</TreeDataGridUnoTargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TreeDataGridSourceRoot)/src/TreeDataGrid.Controls.Uno/TreeDataGrid.Controls.Uno.csproj" />
    <ProjectReference Include="$(TreeDataGridSourceRoot)/src/TreeDataGrid.Core/TreeDataGrid.Core.csproj" />
  </ItemGroup>
</Project>
